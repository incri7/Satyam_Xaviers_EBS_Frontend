# ── API base URL ──────────────────────────────────────────────────────────────
# Local dev: point directly at the backend server
VITE_API_BASE_URL=http://localhost:8002/

# Docker / production: route through Nginx at /api/
# VITE_API_BASE_URL=/api/

# ── WebSocket (real-time dashboard) ───────────────────────────────────────────
# Local dev: direct backend websocket
VITE_WS_URL=ws://localhost:8002/ws
# Docker / production behind Nginx:
# VITE_WS_URL=wss://your-domain/ws

# ── Firebase Cloud Messaging (push notifications) ─────────────────────────────
# All five are required for push; if unset, FCM silently disables (no push).
# From Firebase console → Project settings → General + Cloud Messaging.
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_FIREBASE_VAPID_KEY=

# ── Error tracking (optional) ─────────────────────────────────────────────────
# From sentry.io → project settings. Unset = disabled.
VITE_SENTRY_DSN=
